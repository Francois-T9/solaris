

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserBill {

  id Int @id @default(autoincrement())
 
  email String @unique
  billURL String?
  
}

model UserContact {

  id Int @id @default(autoincrement())
 
  name String
  surname String
  email String @unique
  requestType String
  question String

}
