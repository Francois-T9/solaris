generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {  
   id        Int      @id @default(autoincrement())
 
  name             String
  surname          String
  email            String      @unique
  bill     Bill?    
  request  Request? 
  car       Manufacturer? @relation(fields: [manufacturerName], references: [name])
  manufacturerName String?
}

model Bill {
  id        Int      @id @default(autoincrement())
  billName  String
  billUrl   String
  createdAt DateTime @default(now())

 
  user   User  @relation( fields: [userEmail], references: [email])
  userEmail String   @unique
}

model Request {
  id Int @id @default(autoincrement())

  requestType String
  comment     String
   user   User @relation( fields: [userEmail], references: [email])
  userEmail String @unique
}

model Manufacturer {
  name String @id

  users User[]
}
